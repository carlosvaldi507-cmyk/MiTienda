rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function administrador() {
      // Cuenta propietaria actual. El UID lo asigna Firebase y no puede ser
      // elegido ni alterado por un cliente desde el navegador.
      return autenticado()
        && request.auth.uid == "PK8B1k9c2vasxqJbMnPIff1uINB2";
    }

    // Catálogo público: solo el administrador puede cambiarlo.
    match /productos/{productoId} {
      allow read: if resource.data.activo == true || administrador();
      allow write: if administrador();
    }

    // Perfil, favoritos y direcciones: privados por cliente.
    match /usuarios/{usuarioId} {
      allow create: if autenticado() && request.auth.uid == usuarioId;
      allow read, update, delete: if autenticado()
        && (request.auth.uid == usuarioId || administrador());
    }

    // Los pedidos se crean únicamente desde la función de servidor.
    // El cliente solo puede consultar los suyos.
    match /pedidos/{pedidoId} {
      allow read: if autenticado()
        && (resource.data.clienteUid == request.auth.uid || administrador());
      allow write: if false;
    }

    // Todo documento no definido queda bloqueado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
